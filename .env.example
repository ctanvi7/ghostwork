# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=false
FLASK_TESTING=false

# Database
DB_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Freshdesk Integration (choose: MCP primary, REST fallback)
# FRESHDESK_PROVIDER: Set to "mcp" (default) or "rest"
FRESHDESK_PROVIDER=mcp

# Freshdesk MCP (Model Context Protocol) - Primary Provider
# MCP_FRESHDESK_URL: MCP server endpoint (e.g., https://domain.freshdesk.com/mcp)
# MCP_FRESHDESK_AUTH_TOKEN: Authentication token for MCP (without "fwapi_" prefix)
MCP_FRESHDESK_URL=
MCP_FRESHDESK_AUTH_TOKEN=

# Freshdesk REST API v2 - Fallback Provider
# FRESHDESK_DOMAIN: Your Freshdesk domain (e.g., acme or acme.freshdesk.com)
# FRESHDESK_API_KEY: Your API key from Profile Settings
# Used only if MCP is unavailable
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
# Optional: FRESHDESK_FALLBACK=cache to use cached ticket when API unavailable
FRESHDESK_FALLBACK=
# Real ticket ID for the refund demo (Freshdesk assigns IDs, so 2048 may not exist)
FRESHDESK_DEMO_TICKET_ID=2048
# API name of the refund amount custom field (Freshdesk adds "cf_" to the name you type)
FRESHDESK_REFUND_AMOUNT_FIELD=cf_refund_amount
# Close the ticket after approval, write-back and read-back verification all pass
FRESHDESK_AUTO_CLOSE=true

# Vobiz (Voice)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=+91...
# The number called is the Freshdesk ticket assignee's (agent profile mobile, then phone).
# APPROVER_PHONE is used only if the ticket has no assignee with a valid number.
APPROVER_PHONE=
# Country code added to 10-digit local numbers in Freshdesk profiles
VOBIZ_DEFAULT_COUNTRY_CODE=91
# Must be a public HTTPS URL Vobiz can reach (e.g. an HTTPS tunnel to localhost:5000)
PUBLIC_BASE_URL=

# Sarvam (Speech-to-Text/Text-to-Speech)
SARVAM_API_KEY=your-sarvam-key

# Governance and Execution
AUTO_APPROVAL_LIMIT=25000
REQUIRE_APPROVER_AUTH=false
# Voice callbacks require a public HTTPS URL (for example a tunnel during local testing).
PUBLIC_BASE_URL=http://localhost:5000
EXECUTOR_TIMEOUT_SECONDS=120
