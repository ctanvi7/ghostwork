# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here
FLASK_DEBUG=false
FLASK_TESTING=false

# Database
DB_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5

# Freshdesk (REST API v2)
# FRESHDESK_DOMAIN: Your Freshdesk domain (e.g., acme.freshdesk.com)
# FRESHDESK_API_KEY: Your API key from Profile Settings
# Both must be set to enable live Freshdesk ticket fetching
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
# Optional: FRESHDESK_FALLBACK=cache to use cached ticket when API unavailable
FRESHDESK_FALLBACK=

# Vobiz (Voice)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=+91...
APPROVER_PHONE=+91...

# Sarvam (Speech-to-Text/Text-to-Speech)
SARVAM_API_KEY=your-sarvam-key

# Governance and Execution
AUTO_APPROVAL_LIMIT=25000
REQUIRE_APPROVER_AUTH=false
# Voice callbacks require a public HTTPS URL (for example a tunnel during local testing).
PUBLIC_BASE_URL=http://localhost:5000
EXECUTOR_TIMEOUT_SECONDS=120
